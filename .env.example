# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env` (jamais commité) et renseignez les valeurs.
# Utilisé par : docker compose, packages/database (Prisma CLI), apps/api.
# En production, définissez ces variables dans l'environnement d'exécution :
# elles sont prioritaires sur le fichier .env.
# ----------------------------------------------------------------------------

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=tunnel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tunnel
POSTGRES_PORT=5432

# --- Prisma / API ---
DATABASE_URL=postgresql://tunnel:change-me@localhost:5432/tunnel?schema=public

# --- API NestJS ---
NODE_ENV=development
API_PORT=3001
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000

# --- API externes ---
# Chaque API externe est identifiée par un NOM (majuscules, ex : METEO) et
# enregistrée dans le code via ExternalApiModule.register('METEO').
# Variables lues pour ce NOM :
#   <NOM>_API_URL          (obligatoire) URL de base
#   <NOM>_API_TOKEN        (optionnel)  -> en-tête "Authorization: Bearer <token>"
#   <NOM>_API_KEY          (optionnel)  -> en-tête <NOM>_API_KEY_HEADER (défaut : x-api-key)
#   <NOM>_API_KEY_HEADER   (optionnel)
#   <NOM>_API_USERNAME     (optionnel)  -> authentification Basic, avec <NOM>_API_PASSWORD
#   <NOM>_API_PASSWORD     (optionnel)
#   <NOM>_API_TIMEOUT_MS   (optionnel)  défaut : 10000
#
# Exemple :
# METEO_API_URL=https://api.example.com/v1
# METEO_API_KEY=xxxxxxxx
# METEO_API_KEY_HEADER=x-api-key
