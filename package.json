{
  "name": "tunnel",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tunnel/database db:generate",
    "db:migrate": "pnpm --filter @tunnel/database db:migrate",
    "db:deploy": "pnpm --filter @tunnel/database db:deploy",
    "db:studio": "pnpm --filter @tunnel/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  }
}
